# Copy to .env and fill in only the keys you have.
# Never commit .env. This process refuses to log these values.

# LLM. Leave blank to run the deterministic baseline strategy only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Binance Spot TESTNET keys (https://testnet.binance.vision/).
# These are the only keys the paper broker will send.
PAPER_API_KEY=
PAPER_API_SECRET=

# Production keys. Ignored unless every live-trading gate is passed.
# Live trading is off by default and is not required for this project.
LIVE_API_KEY=
LIVE_API_SECRET=
LIVE_TRADING=false

# Optional. If unset, that social source is skipped and the bot continues.
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=crypto-paper-bot/0.1 by local-research
